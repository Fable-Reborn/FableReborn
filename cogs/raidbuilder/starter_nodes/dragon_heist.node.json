    {
      "id": "mothers_fury",
      "kind": "choice",
      "title": "A Mother's Fury",
      "text": "Her eyes find the egg in your arms, and the heat in the cavern doubles. \"GIVE. IT. BACK.\"\n\nReturn it and she will let you leave, taking every coin as her price. Keep it, and she fights with a mother's rage.",
      "choices": [
        {
          "id": "return",
          "label": "Return the egg (lose all gold)",
          "next": "egg_returned"
        },
        {
          "id": "keep",
          "label": "Keep it and run!",
          "next": "dragon_battle"
        }
      ],
      "failure": "dragon_battle",
      "rules": []
    },
    {
      "id": "egg_returned",
      "kind": "scene",
      "title": "A Fair Trade",
      "text": "You set the egg down gently. She curls around it and watches, unblinking, as you empty your pockets and back out of her home.",
