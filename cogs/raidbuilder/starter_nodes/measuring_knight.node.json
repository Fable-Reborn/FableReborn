{
  "schema": "fablereborn.raid-node",
  "version": 1,
  "name": "The Measuring Knight",
  "description": "A duel that scales to the party. A System step reads the party's live average level: below 30 fights a blunted squire trial, 30-69 a true duel, and 70+ the Knight Unhelmed with a second wind. First the party votes to accept the challenge or ambush him. An ambush opens with 25% of his HP but ends in Dishonor. He yields at 40% HP (bested) or after 6 rounds (impressed). Parry lets anyone endure. Honor earns the Knight's Favor. Next: every outcome.",
  "entry": "knight_arrives",
  "nodes": [
    {
      "id": "knight_arrives",
      "kind": "scene",
      "title": "The Measuring Knight",
      "text": "A knight in silver armor blocks the bridge, a measuring tape (yes, really) hanging from his belt beside his sword.\n\n\"Halt. None cross until I have taken your measure. I shall fight you as you *deserve* to be fought.\"",
      "next": "honor_choice",
      "rules": []
    },
    {
      "id": "honor_choice",
      "kind": "choice",
      "title": "Honor or Ambush?",
      "text": "He turns to fetch his shield, leaving his back wide open...",
      "choices": [
        {
          "id": "accept",
          "label": "Accept his challenge with honor",
          "next": "take_measure"
        },
        {
          "id": "ambush",
          "label": "Ambush him while his back is turned",
          "next": "ambush"
        }
      ],
      "failure": "take_measure",
      "rules": []
    },
    {
      "id": "ambush",
      "kind": "scene",
      "title": "A Dishonorable Plan",
      "text": "Someone creeps up behind him, weapon raised. It will work. It will also be remembered.",
      "next": "take_measure",
      "rules": [
        {
          "id": "knight_dishonor",
          "trigger": "enter",
          "condition": {
            "operator": "always"
          },
          "effect": "resource",
          "target": "all",
          "amount": 1,
          "resource": "knight_dishonor",
          "status": "",
          "destination": "",
          "limit": 1,
          "text": "Dishonor +1. Knights keep ledgers too."
        }
      ]
    },
    {
      "id": "take_measure",
      "kind": "system",
      "title": "Taking Your Measure",
      "text": "He squints at you along the length of his blade, sizing up every scar and callus. (Reads the party's average character level.)",
      "source": "party_level_average",
      "output_resource": "knight_measure",
      "simulation_value": 45,
      "next": "legend_check",
      "failure": "duel_knight",
      "rules": []
    },
    {
      "id": "legend_check",
      "kind": "check",
